@model UniBook.Models.Book

<table>
    <tr><th>@Html.DisplayNameFor(model => model.courseCode)</th><td>@Html.DisplayFor(model => model.courseCode)</td></tr>
    <tr><th>@Html.DisplayNameFor(model => model.title)</th><td>@Html.DisplayFor(model => model.title)</td></tr>
    <tr><th>@Html.DisplayNameFor(model => model.faculty)</th><td>@Html.DisplayFor(model => model.faculty)</td></tr>
    <tr><th>@Html.DisplayNameFor(model => model.version)</th><td>@Html.DisplayFor(model => model.version)</td></tr>
    <tr><th>@Html.DisplayNameFor(model => model.newPrice)</th><td>@Html.DisplayFor(model => model.newPrice) SR</td></tr>
    <tr><th>@Html.DisplayNameFor(model => model.usedPrice)</th><td>@Html.DisplayFor(model => model.usedPrice) SR</td></tr>
