<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>UniBook - @ViewData["Title"]</title>
    <link rel="stylesheet" type="text/css" href="~/style.css" />
    <script src="~/script.js"></script>
    @await RenderSectionAsync("Head", required: false)
</head>

<body>
    <header>
        <img src="~/logo.jpg" alt="UniBook logo" width="120" height="120" usemap="#logo" />
        <map name="logo">
            <area shape="rect" coords="0,0,120,120" href="@Url.Action("About", "Home", new { area = "" })" alt="Go to About Us" />
        </map>
        <h1>UniBook</h1>
    </header>

    <nav>
        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
        <a asp-area="" asp-controller="Books" asp-action="Index">Books</a>
        <a asp-area="" asp-controller="Books" asp-action="SearchForm">Search</a>
        <a asp-area="" asp-controller="Home" asp-action="About">About Us</a>
        <a asp-area="" asp-controller="Account" asp-action="Index">User Account</a>
        <partial name="_LoginPartial" />
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div style="font-size: 20px; text-align: right">
            <h3 class="title">About Us</h3>
            <a asp-area="" asp-controller="Home" asp-action="About"><img src="~/icoabo.png" alt="About icon" width="90" height="90" class="below"></a>
            <img src="~/handab.png" alt="Pointing hand" width="45" height="45" class="above">
        </div>
        <b class="z">Customer Service</b>
        <address>
            <a href="mailto:aalmeri0003@stu.kau.edu.sa">aalmeri0003@stu.kau.edu.sa</a><br />
            <a href="mailto:rbarnawi0015@stu.kau.edu.sa">rbarnawi0015@stu.kau.edu.sa</a>
        </address>
        <h6>&copy; 2026 UniBook - King Abdulaziz University. All rights reserved </h6>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
