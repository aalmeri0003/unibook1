@{
    ViewData["Title"] = "Account";
    var cookies = Context.Request.Cookies;
}

<h2>Account Information</h2>

<section>
    <h3>Cookie Values</h3>
    <ul>
        @foreach (var c in cookies)
        {
            <li>@c.Key : @c.Value</li>
        }
    </ul>
</section>

<section>
    <h3>Session Values</h3>
    <ul>
        <li>Session id : @ViewBag.sessionId</li>
        <li>Username : @ViewBag.sessionUserName</li>
        <li>Home page visits : @ViewBag.homeVisits</li>
        <li>Last book opened : @ViewBag.lastBook</li>
    </ul>
    <form asp-action="ClearSession" method="post">
        <input type="submit" value="Clear Session" />
    </form>
</section>

<p><a href="@Url.Action("Index", "Home")">Back to Home</a></p>
