<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- UniBook database file in App_Data (created automatically the first time the site runs) -->
    <add name="UniBookDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\UniBook.mdf;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- read the pages as UTF-8 so special letters show correctly -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- users stay logged in for 20 minutes without activity -->
    <sessionState timeout="20" />
  </system.web>
  <system.webServer>
    <!-- open index.aspx when the site starts -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
